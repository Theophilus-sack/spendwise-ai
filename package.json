{
  "name": "spendwise-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "packages/shared"
  ],
  "scripts": {
    "mobile": "bun run --cwd apps/mobile start",
    "mobile:android": "bun run --cwd apps/mobile android",
    "mobile:ios": "bun run --cwd apps/mobile ios",
    "test": "bun run --cwd packages/shared test",
    "test:mobile": "bun run --cwd apps/mobile test",
    "lint": "bun run --cwd apps/mobile lint",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
