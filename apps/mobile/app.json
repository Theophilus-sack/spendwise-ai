{
  "expo": {
    "name": "SpendWise AI",
    "slug": "spendwise-ai",
    "scheme": "spendwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A6B4A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.spendwise.ai",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan receipts for automatic expense entry",
        "NSFaceIDUsageDescription": "Used to unlock the app securely",
        "NSPhotoLibraryUsageDescription": "Used to select receipt images",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A6B4A"
      },
      "package": "com.spendwise.ai",
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1A6B4A"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SpendWise AI to access your camera to scan receipts."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow SpendWise AI to access your microphone to record expenses by voice."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow SpendWise AI to access your microphone to record expenses by voice.",
          "speechRecognitionPermission": "Allow SpendWise AI to use speech recognition to transcribe expenses you say out loud."
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "eas": {
        "projectId": "b236c573-7f74-4dc3-9a9b-6a4b7949d320"
      }
    },
    "owner": "theophilus23"
  }
}
